# Optional: guaranteed connectivity on ANY network (recommended if the phone cannot reach the PC)
#
# Why you might need this:
#   - The phone cannot reach the agent over LAN/Wi-Fi (AP isolation, strict firewall).
#   - The PC-to-phone path fails because public Nostr relays are flaky in your region.
#   - You want 100% reliability instead of "usually works".
#
# What you need (2 minutes, free):
#   1. Cloudflare account → dashboard → Realtime → TURN (free tier: 1,000 GB/month)
#   2. Copy the generated TURN credentials (username + credential).
#   3. Copy this file to:
#        <agent userData>/turn.json           (e.g. %APPDATA%\@remotex\agent\turn.json)
#        web/turn.json                        (for local dev / preview)
#      or deploy turn.json next to index.html on GitHub Pages (or drop it into
#        your fork of the repo — it is git-ignored and never committed by default).
#
# turn.json schema:
#   {
#     "urls": ["turn:turn.cloudflare.com:3478?transport=udp", "turn:turn.cloudflare.com:3478?transport=tcp"],
#     "username": "<cloudflare username>",
#     "credential": "<cloudflare credential>"
#   }
#
# Media stays end-to-end encrypted (DTLS-SRTP) — the TURN relay sees only encrypted packets.
# If turn.json is missing or invalid, RemoteX silently falls back to direct P2P (STUN + LAN).
{
  "urls": ["turn:turn.cloudflare.com:3478?transport=udp", "turn:turn.cloudflare.com:3478?transport=tcp"],
  "username": "REPLACE_WITH_YOUR_USERNAME",
  "credential": "REPLACE_WITH_YOUR_CREDENTIAL"
}
